# =============================================================================
# CYBER PLATFORM — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
LOG_LEVEL=INFO

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyberplatform
POSTGRES_USER=cyberuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://cyberuser:CHANGE_ME_strong_password@postgres:5432/cyberplatform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── RQ Worker ─────────────────────────────────────────────────────────────────
RQ_QUEUE_NAME=analysis
RQ_MAX_RETRIES=3
RQ_RETRY_DELAY_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_ROOT=/app/storage
QUARANTINE_ROOT=/app/quarantine
MAX_UPLOAD_BYTES=52428800

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=10/minute

# ── Seed / Demo ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cyber.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ANALYST_EMAIL=analyst@cyber.local
SEED_ANALYST_PASSWORD=Analyst1234!
SEED_VIEWER_EMAIL=viewer@cyber.local
SEED_VIEWER_PASSWORD=Viewer1234!
