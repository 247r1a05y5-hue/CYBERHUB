# =============================================================================
# CYBER PLATFORM — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
LOG_LEVEL=INFO

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Production: set DATABASE_URL to a PostgreSQL connection string.
# Development/test: SQLite is allowed (default).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyberplatform
POSTGRES_USER=cyberuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://cyberuser:CHANGE_ME_strong_password@postgres:5432/cyberplatform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── RQ Worker ─────────────────────────────────────────────────────────────────
RQ_QUEUE_NAME=analysis
RQ_MAX_RETRIES=3
RQ_RETRY_DELAY_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. In production set to your real frontend domain.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=https://your-frontend.up.railway.app
CORS_ALLOW_CREDENTIALS=true

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_ROOT=/app/storage
QUARANTINE_ROOT=/app/quarantine
MAX_UPLOAD_BYTES=52428800

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=10/minute

# ── Image Search Provider (SearchAPI Google Lens) ────────────────────────────
# Get your key at https://www.searchapi.io — keep server-side only, NEVER expose in frontend.
SEARCHAPI_API_KEY=YOUR_SEARCHAPI_KEY_HERE
SEARCHAPI_ENGINE=google_lens
SEARCHAPI_ENABLED=true
ALLOW_TEST_MOCK_PROVIDER=false

# ── Public Base URL (required for SearchAPI crawler access) ──────────────────
# Must be a publicly routable URL so SearchAPI crawlers can fetch temp images.
# Set to your Railway backend public URL in production.
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# ── Qdrant Vector Database (optional) ────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cyberhub_image_embeddings

# ── Frontend (Vite build-time variables) ─────────────────────────────────────
# Set VITE_API_BASE_URL to your backend Railway URL for production builds.
VITE_API_BASE_URL=https://your-backend.up.railway.app

# ── Seed / Demo (DEVELOPMENT & TEST ONLY — never in production) ──────────────
SEED_ADMIN_EMAIL=admin@cyber.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ANALYST_EMAIL=analyst@cyber.local
SEED_ANALYST_PASSWORD=Analyst1234!
SEED_VIEWER_EMAIL=viewer@cyber.local
SEED_VIEWER_PASSWORD=Viewer1234!
